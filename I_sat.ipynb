    "import numpy as np\n",
    "I_sat = 2.7059 # mW/cm^2\n",
    "P = np.array([0.0001,0.1,0.2,0.5,1,3.5])\n",
    "w_W = 47.1*1e-4\n",
    "w_V = 57.6*1e-4\n",
    "I = 2*P/(np.pi*w_W*w_V) # mW/cm^2\n",
    "print(I/I_sat)"
   ]
